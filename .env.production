# Production build flags. Non-secret. The backend flag YARD_INVOICE_UPLOAD_ENABLED is set on the live server.
VITE_YARD_INVOICE_UPLOAD_ENABLED=true
# ShipLink invoice upload: same review as Yard. The backend flag SHIPLINK_INVOICE_UPLOAD_ENABLED is set on the live server.
VITE_SHIPLINK_INVOICE_UPLOAD_ENABLED=true
# Credit note settlement upload. The backend flag CREDIT_NOTE_SETTLEMENT_ENABLED is set on the live server.
VITE_CREDIT_NOTE_SETTLEMENT_ENABLED=true
